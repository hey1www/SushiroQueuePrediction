APP_ENV=production
API_HOST=0.0.0.0
API_PORT=8000
DATABASE_URL=sqlite:///./data/sushiro_hk.db
COLLECT_INTERVAL_SECONDS=120
REQUEST_TIMEOUT_SECONDS=15
STORELIST_URL=https://sushipass.sushiro.com.hk/api/2.0/info/storelist?latitude=22&longitude=114&numresults=25&region=HK
GROUPQUEUES_URL_TEMPLATE=https://sushipass.sushiro.com.hk/api/2.0/remote/groupqueues?region=HK&storeid={store_id}
CORS_ALLOW_ORIGINS=["https://hey1www.github.io","https://sushi.heyi-direct.site","http://localhost:5173"]
ETA_ALPHA=0.8
ETA_MIN_RATE=0.1
ETA_MAX_MINUTES=180
LOG_LEVEL=INFO
